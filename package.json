{
  "name": "libre-weather-api",
  "version": "1.0.7",
  "description": "Open Weather APIs for the Open Sky",
  "keywords": [
    "floss",
    "open",
    "weather"
  ],
  "homepage": "https://github.com/LibreWeather/libre-weather-api#readme",
  "bugs": {
    "url": "https://github.com/LibreWeather/libre-weather-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LibreWeather/libre-weather-api.git"
  },
  "license": "AGPL-3.0",
  "author": "tobitenno",
  "contributors": [
    "jkuester"
  ],
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --delay 5 --watch .env --watch src src/server.js",
    "lint": "eslint . --config .config/eslint.config.mjs",
    "lint:fix": "eslint . --config .config/eslint.config.mjs --fix",
    "prepare": "husky || exit 0",
    "start": "node src/server.js",
    "test": "exit 0"
  },
  "release": {
    "extends": "./.config/.releaserc.yaml"
  },
  "overrides": {
    "axios": "^1.12.2",
    "brace-expansion": "^1.1.12",
    "form-data": "^4.0.4",
    "js-yaml": "^4.1.1",
    "minimatch": "^9.0.5",
    "picomatch": "^4.0.3",
    "qs": "^6.14.0",
    "send": "^1.2.0",
    "uuid": "^11.1.0"
  },
  "dependencies": {
    "apicache": "^1.6.3",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-favicon-short-circuit": "^1.2.0",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "swagger-stats": "^0.99.7",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@types/apicache": "^1.2.2",
    "@types/cors": "^2.8.6",
    "@types/express": "^5.0.0",
    "@types/swagger-ui-express": "^4.1.7",
    "dotenv": "^16.6.1",
    "eslint": "^10.0.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-yml": "^1.19.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
